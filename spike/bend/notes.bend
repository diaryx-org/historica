# The texts `init` writes, taken from what the Rust tool's `init` lays
# down by `notes.py`, which says how to take them up again. Nothing reads
# them: they are for a person who opens the folder. And the usage text,
# taken from what the Rust tool's `help` prints.

import Base

# What `historica.txt` holds: the format line, the blank line reserved
# under it, and the note to whoever opens the folder.
def HEADER_NOTE() -> String:
  String.join([
    "historica",
    "",
    "This folder is a Historica store: the recorded history of the files beside it.",
    "",
    "Everything in it is text you can read, and none of it needs Historica to read.",
    "Identity comes from content — a document is named by the SHA-256 of its own",
    "bytes, which `shasum -a 256` prints — so a filename here is only ever",
    "presentation. Renaming anything in this folder breaks nothing, and filing it",
    "into directories of your own breaks nothing either.",
    "",
    "  revisions/      one file per revision: who recorded what, when, and why, and",
    "                  which revisions came before it, filed under the year and",
    "                  month it was recorded in.",
    "  operations/     what each revision did, filed under the revision that did it,",
    "                  at the path the file had, under that same year and month. A",
    "                  `.ops.txt` file lists the lines that revision deleted and",
    "                  inserted; every other file there is a file's own content,",
    "                  stored whole.",
    "  names/          bookmarks, one line each, and at most one more: a second",
    "                  line saying `private` keeps the bookmark's own name out of",
    "                  an `export`. A bookmark's name is its path below here",
    "                  without `.txt`, so a name may have directories in it —",
    "                  `names/feature/x.txt` is the bookmark `feature/x`. The only",
    "                  files here that change.",
    "  cache/          derived and disposable: files you have already read, kept",
    "                  under the digest their history says they hash to, so that",
    "                  reading them again does not replay it, and operations.txt,",
    "                  which says where in operations/ each digest is. Deleting",
    "                  all of it loses nothing.",
    "  skipped/        what recording does not take, one rule to a file. A rule",
    "                  is a key, a space, and a value: `skip <path>` and `skip",
    "                  <path>/`, or `skip-name <name>` and `skip-name <name>/`,",
    "                  where the name is one path component and `*` is any run of",
    "                  characters in it. `private` and `private-name` say the same",
    "                  things and are not written into an `export`.",
    "  format.txt      every grammar above, spelled out: what each line of each",
    "                  document means, and how to materialise a file from them",
    "                  with an editor and `shasum`. Read that one if you have no",
    "                  Historica and want your files back.",
    "",
    "The first line of this file states the format. A reader that does not know",
    "that format refuses the store rather than guessing at what it would be",
    "leaving out.",
    "",
    "Under that line is a blank one, and under that this note, which is for you and",
    "which nothing reads. The gap between them is reserved: it is where a later",
    "Historica will state what a store uses that this one had no name for, so that",
    "an older reader is told it is old rather than left to read the store wrong. It",
    "is empty in every store this release writes, and a reader meeting anything",
    "there refuses the store and says so. Keep the blank line if you write a note",
    "of your own here.",
    "",
    "Whether this copy is whole is a different question from whether it contradicts",
    "itself, and `historica check --complete` asks both. Plain `check` fails only on",
    "a store that disagrees with itself; `--complete` also fails where a revision",
    "names bytes this copy does not hold, which is what a backup about to be trusted",
    "— or a sync that should have finished — is asking.",
    "",
    "`historica help` lists what the tool can do with all of this."
  ], "\n") ++ "\n"

# `skipped/README.txt`: the rule syntax, explained, and no rule stated.
def SKIPPED_NOTE() -> String:
  String.join([
    "# What recording does not take: one rule to a file, and this file states none.",
    "# A rule is a key, a space, and a value. `skip <path>` names one file and",
    "# `skip <path>/` everything under a directory; `skip-name <name>` matches a",
    "# file's own name at any depth and `skip-name <name>/` a directory's, where",
    "# `*` stands for any run of characters within the one name. A `#` line says",
    "# nothing.",
    "#",
    "# `private` and `private-name` say the same things and are not written into an",
    "# `export`, which is the only copy this design builds smaller than the store.",
    "# A path covered both privately and shared is named in the copy anyway, and",
    "# `check` reports it.",
    "#",
    "# The filename is a label for whoever opens this folder; the rule is what the",
    "# file holds. Delete a file to drop its rule, and note that a store you receive",
    "# from can hand it back, because a copy cannot tell a rule you deleted from a",
    "# rule it has not seen yet."
  ], "\n") ++ "\n"

# `format.txt`: every grammar in the store, for a reader with no Historica.
def FORMAT_NOTE() -> String:
  String.join([
    "How to read this store without Historica",
    "========================================",
    "",
    "Everything here is UTF-8 text with Unix line endings, and every document is",
    "named by the SHA-256 of its own bytes. `shasum -a 256 <file>` prints that",
    "digest, and it is the only name a document has: a filename is presentation",
    "and may be anything.",
    "",
    "Every document begins with the preamble line `historica`, which names the one",
    "format this store keeps. A reader that meets any other spelling there refuses",
    "that document rather than guessing at what it would be leaving out.",
    "",
    "Two identifiers appear throughout and are never digests, because they are",
    "spelled in an alphabet no hexadecimal digest can be:",
    "",
    "  a change ID    24 characters from `k` to `z`. The piece of work a revision",
    "                 is a version of. Amending produces a new revision with the",
    "                 same change ID.",
    "  a file ID      24 characters from `k` to `z`. A file, for as long as it",
    "                 exists, whatever path it is at. Paths are properties of a",
    "                 file, never its identity.",
    "",
    "",
    "historica.txt — what this folder is, and what it uses",
    "------------------------------------------------------",
    "",
    "  historica",
    "",
    "  This folder is a Historica store: the recorded history of the files",
    "  beside it.",
    "  ...",
    "",
    "The first line is the preamble, the same one every document here begins with,",
    "and it is what a reader checks before it reads anything else. Then a blank",
    "line, then a note for whoever opens the folder, which no reader parses.",
    "",
    "Between the preamble and the blank line is a block of headers, and it is",
    "empty. Nothing this format defines is written there. It is reserved, so that a",
    "later Historica has somewhere to say what a store uses that this one had no",
    "name for: a reader meeting a line it does not know there refuses the store and",
    "says a newer Historica likely wrote it, rather than reading the parts it",
    "recognises and calling the result a history. So the blank line matters if you",
    "write a note of your own — a note beginning on the second line is read as one",
    "of those headers, and refused as one.",
    "",
    "The block can be here because this file is not hashed and nothing references",
    "it. It could not be in a document: a document is named by the digest of its",
    "own bytes, so a line added to one renames it, and a store could not gain a",
    "gate without every revision in it changing identity.",
    "",
    "",
    "revisions/*.rev.txt — who recorded what, when, and why",
    "------------------------------------------------------",
    "",
    "  historica",
    "  change qpvuntsmwlrkzxonmvtplsyq",
    "  author Adam Harris <adam@example.com>",
    "  when 2026-08-19T09:12:04-06:00",
    "  add nrqvtkzlmwyxsptonvqrklmz notes.txt",
    "  add swtlmnkqvzyrxopwstlnmkqv README.md",
    "  text nrqvtkzlmwyxsptonvqrklmz 3eca7ea48b0da0ad30bee679c92c7b68d487547068b6914d10a64e8cedb03f51",
    "  text swtlmnkqvzyrxopwstlnmkqv 11db37f8c5cb4384341f3e5240d5c7f4d6fb3bdf90d95337f7c57b456a5eb162",
    "",
    "  Start the notes both hands will edit",
    "",
    "A root, so no `parent` line. Headers, then one blank line, then the message",
    "verbatim; a document with no message has no blank line either. Headers appear",
    "in this order, and repeated ones are sorted by the value that follows them:",
    "",
    "  change <change ID>              exactly once.",
    "  parent <digest>                 a revision this one is recorded against.",
    "                                  None means a root; two or more means a merge.",
    "  supersedes <digest>             a revision this one replaces.",
    "  author <name and address>       who did the work.",
    "  when <RFC 3339 timestamp>       when they did it.",
    "  revised-by <name and address>   who rewrote it, if that is someone else.",
    "  revised <RFC 3339 timestamp>    when it was rewritten. Present exactly when",
    "                                  `supersedes` is.",
    "  add <file ID> <path>            a file this revision brings into existence.",
    "  move <file ID> <path>           where a file this revision moves goes.",
    "  mode <file ID> <plain|executable>",
    "                                  whether a file can be run, stated by the",
    "                                  revision that changes it. A file no `mode`",
    "                                  line has ever named is plain.",
    "  drop <file ID>                  a file this revision removes from the file",
    "                                  set. Its history is untouched.",
    "  edit <file ID> <digest>         the document in `operations/` that says what",
    "                                  this revision did to that file.",
    "  text <file ID> <digest>         the payload in `operations/` an added file",
    "                                  arrives as, read as lines.",
    "  bytes <file ID> <digest>        the payload that is a file's whole content,",
    "                                  which has no lines and never merges.",
    "  link <file ID> <target>         where a link points, stated by the revision",
    "                                  that adds it — where `text` or `bytes` would",
    "                                  have stated content — and restated by any",
    "                                  revision that changes it. The target is the",
    "                                  rest of the line, and has two spellings:",
    "",
    "                                    link kx.. file:<file ID>",
    "                                    link kx.. ../elsewhere/notes.txt",
    "",
    "                                  The first is a link to a file *in this",
    "                                  history*, by identity, so it follows that",
    "                                  file through every rename. The second is the",
    "                                  string a person wrote, kept as the string it",
    "                                  is, for a target this history knows nothing",
    "                                  about. No revision may drop a file while a",
    "                                  `file:` link still names it.",
    "  <tool>.<fact> <value>           a header some other tool wrote, and the dot",
    "                                  is what says so: no header this format",
    "                                  defines holds one, as in",
    "                                  `diaryx.review-url`. Ignore it; it hashes",
    "                                  like everything else.",
    "",
    "Paths are slash-separated and relative to the folder beside this one, and",
    "spelled in Unicode normal form C — so `café.md` holds one U+00E9 rather than",
    "`e` and a combining acute. That is what most things write; if your editor",
    "writes the other one, the two look identical and only one of them parses.",
    "",
    "",
    "operations/*.ops.txt — what a revision did to one file",
    "-------------------------------------------------------",
    "",
    "  historica",
    "  result cb6ada97d1b93c8500aa1b3312fade8453a118126196c2a0f257b801f7b56118",
    "",
    "  delete 2 1",
    "  -charlie",
    "  insert 3",
    "  +echo",
    "",
    "Preamble, then headers, then one blank line, then the operations.",
    "",
    "  result <digest>   the SHA-256 of the file this document produces. Every",
    "                    document this tool writes states one. It is the",
    "                    checkpoint: replay the operations by hand, `shasum -a 256`",
    "                    the file you get, and compare.",
    "  forgets <digest>  this document stands in for another whose bytes were",
    "                    destroyed. See \"Forgetting\" below.",
    "",
    "Each operation is a line, then the lines it concerns:",
    "",
    "  insert <at>          followed by one `+line` per item inserted.",
    "  delete <at> <count>  followed by one `-line` per item removed, quoted",
    "                       verbatim so a replay can check itself.",
    "",
    "**Positions are indices into the state at the revision's parents**, counted",
    "from zero, and none of them move. `delete 2 1` then `insert 3` both count into",
    "the same fixed file, which is what lets you check a document by eye against",
    "one state. An insert at a position goes before whatever that state held there;",
    "an insert at the state's length goes at the end.",
    "",
    "Operations are sorted by position, never overlap, and never state one fact",
    "twice, so exactly one byte sequence spells any set of operations.",
    "",
    "Two lines stand outside the item grammar, and both begin with a backslash:",
    "",
    "  \\ no newline   the item above it is the file's last and ends without a",
    "                 newline. Only a file's last item may.",
    "  \\ forgotten    the item above it had its text destroyed. See below.",
    "",
    "An item's own text may hold anything, including a carriage return; the",
    "document's newline is the terminator, and the text is everything before it.",
    "",
    "",
    "operations/*.ops.txt — a merge's file, stated whole",
    "----------------------------------------------------",
    "",
    "A file at a merge whose parents disagree is stated by reference rather than as",
    "a delta. It is filed under the same suffix, and its body is what tells the two",
    "apart: this one begins with `keep` or a bare `insert`.",
    "",
    "  historica",
    "  result 6ca6c14ef2adc8050792d39e9f46b2500af1b9cb71287b3124bc73b8a040c7bf",
    "",
    "  keep 3eca7ea48b0da0ad30bee679c92c7b68d487547068b6914d10a64e8cedb03f51 0 1",
    "  keep 10dcea499a0cf3294873721b1ba43287cc7493b83b7d0aa668047e8f2eaec271 0 1",
    "  keep 3eca7ea48b0da0ad30bee679c92c7b68d487547068b6914d10a64e8cedb03f51 1 1",
    "  insert",
    "  +foxtrot",
    "  keep cbddb8c4c5a54826d39742b1fd53b9a5b4fa9c25cd919c2b82f7aa54198aa502 0 1",
    "",
    "The pieces are the file, in file order, and assembling them is concatenation.",
    "",
    "  keep <digest> <first> <count>   a run of items taken from another document,",
    "                                  counted in that document's order. A document",
    "                                  \"mints\" the items its `+` lines insert, in",
    "                                  the order they appear; a payload mints its",
    "                                  lines. `keep D 0 1` is D's first such item.",
    "  insert                          followed by one `+line` per item, exactly as",
    "                                  above, `\\ no newline` included.",
    "",
    "A run kept is a run *named*, never restated, which is why a resolution is not",
    "self-contained prose: reading one means opening the documents it names. That",
    "is the price of the property it buys — a kept line survives under its own",
    "name, so a branch that edits it merges with it rather than colliding with a",
    "copy of it.",
    "",
    "Pieces are maximal. Two `keep`s of one document whose ranges meet are one",
    "`keep`, and two `insert`s that meet are one `insert`, so exactly one byte",
    "sequence spells any resolution. A `result` is mandatory here.",
    "",
    "",
    "operations/<anything else> — a file's own content",
    "--------------------------------------------------",
    "",
    "Every other file in `operations/` is a payload: a file's content, stored",
    "whole, with no format of its own. Its only claim is its digest. A `text` line",
    "names one that is read as lines; a `bytes` line names one that is not.",
    "",
    "A payload that was forgotten is not there, and a document stands where it",
    "was — see \"Forgetting\" below.",
    "",
    "",
    "What a file holds at a revision",
    "--------------------------------",
    "",
    "One recursive rule, with no algorithm in it:",
    "",
    "  - a file **created** here (a `text` line) is that payload;",
    "  - a file **edited** here (an `edit` line naming an operation document) is",
    "    the parent's state with those operations applied;",
    "  - a file at a **merge whose parents leave it identically** is that agreed",
    "    state, and the merge says nothing about it;",
    "  - a file at a **merge whose parents differ** is its resolution: fetch each",
    "    `keep`'s run from the document it names, splice the inserts, concatenate.",
    "",
    "A file a `link` line names holds none of that: it holds a target, stated by the",
    "most recent revision to state one. Where two concurrent revisions state",
    "different targets, the one in the revision with the lower digest wins, exactly",
    "as it does for two concurrent `move`s.",
    "",
    "Every step is one you can do with an editor, and `result` is what you check it",
    "against. You never have to walk back further than the nearest resolution,",
    "because a resolution *is* the file.",
    "",
    "A merge that states nothing where its parents differ needs the merge",
    "algorithm — the one thing here that is not arithmetic. This tool never writes",
    "one, and `docs/decisions/0007-content-and-merge.md` in the Historica source",
    "describes what reading one takes.",
    "",
    "",
    "Forgetting",
    "----------",
    "",
    "A line can be destroyed without rewriting history. What replaces the document",
    "holding it is a document with the same shape — the same operations, at the",
    "same positions, with the same counts and terminators — and `\\ forgotten` where",
    "the text was. It carries `forgets <digest>` naming what it stands in for.",
    "",
    "An item forgotten anywhere is forgotten everywhere: if any document that",
    "quotes it says `\\ forgotten`, it is gone, and a file materialising through it",
    "shows the marker where the lines were. A state showing a marker is not checked",
    "against a `result`, because those are not the bytes anybody hashed.",
    "",
    "A payload of bytes has no lines and no shape to keep, so forgetting one",
    "destroys the file and leaves this in its place — a document, filed at the name",
    "the payload had, with the document suffix that says it is one:",
    "",
    "  historica",
    "  forgets 11db37f8c5cb4384341f3e5240d5c7f4d6fb3bdf90d95337f7c57b456a5eb162",
    "  length 38",
    "",
    "Two headers, no blank line, and nothing under it: `forgets` is the payload",
    "whose bytes were destroyed, still named by the revision's `bytes` line, and",
    "`length` is how many bytes there were. A `length` header is how you tell this",
    "apart from the other two grammars in this folder, since neither of them has",
    "one. That count is the only shape such a",
    "file has, and keeping it is what lets a reader say how much is gone rather",
    "than only that something is. There is nothing left to materialise, so the",
    "file cannot be written out at any revision that held it — what a person does",
    "about that is record the `drop` that says the file is gone.",
    "",
    "",
    "names/*.txt — bookmarks",
    "-----------------------",
    "",
    "One line each, and at most one more, and the only files here that change. The",
    "bookmark's name is its path below `names/` without `.txt`, so `names/main.txt`",
    "is the bookmark `main` and `names/feature/x.txt` is the bookmark `feature/x`.",
    "A name may have directories in it, and `feature` may be a bookmark while",
    "`feature/x` is another.",
    "",
    "A name is spelled the way a tracked path is: relative, with no empty component",
    "and no `.` or `..`, no leading or trailing space, no control character, and in",
    "Unicode normal form C. A backslash is not a separator here and not a character",
    "either — it is refused, because a name that is one directory on one machine",
    "and two on another is a bookmark that changes shape when its store is copied.",
    "",
    "  change <change ID>   follows the work forward as it is amended.",
    "  revision <digest>    a pin, which does not move.",
    "  file <file ID>       a file, wherever it is.",
    "",
    "A second line, if there is one, is the word `private`, and it says that the",
    "bookmark's own name stays out of an `export`. It makes no claim about the",
    "target and cannot disagree with it. What it withholds is the name and nothing",
    "else: the revisions a bookmark points at are in the copy already, or the",
    "bookmark would not have been a candidate to travel.",
    "",
    "",
    "Directories another tool wrote",
    "-------------------------------",
    "",
    "A directory beside these that is not named here belongs to whichever tool",
    "wrote it. Historica reads nothing in one and reports nothing about one; what",
    "it does know is how each travels, which is declared once per name rather than",
    "worked out per tool:",
    "",
    "  claims/   travels and unions. Immutable files named by the digest of their",
    "            own bytes, which a copy carries whole and a receive adds to",
    "            without ever overwriting a name it already has. Two stores holding",
    "            one name hold one file, so there is nothing to merge. Adding is",
    "            all that ever happens: an export bringing a copy up to date",
    "            carries what the copy lacks and takes nothing away, however much",
    "            else that run withdraws, because a name missing at one end means",
    "            \"not yet arrived\" and never \"deleted\".",
    "  trust/    local only. It never crosses a store boundary, in either",
    "            direction, by any operation. Copy it yourself if you mean to.",
    "",
    "Both are decided by `docs/decisions/0046-who-vouches-for-a-revision.md`, which",
    "gives them to a signing tool outside Historica. A directory nobody reserved",
    "travels nowhere: leaving a file behind can be undone by copying it again, and",
    "carrying one that should have stayed cannot.",
    "",
    "`cache/` is a third kind, and Historica's own: derived, nobody's, and",
    "deletable without loss.",
    "",
    "All of that is about directories somebody else wrote. Where Historica speaks",
    "about its own layout is the header block in `historica.txt`, described above,",
    "and a store that says nothing there uses nothing this file does not describe.",
    "",
    "",
    "Checking a store by hand",
    "-------------------------",
    "",
    "  find revisions operations -type f -exec shasum -a 256 {} +",
    "",
    "Both directories nest — a revision is filed under the year and month it was",
    "recorded in, and what it did is filed under it at the path each file had — so",
    "this walks rather than globs. Depth means nothing to a reader: a file in this",
    "folder is what its bytes are, wherever it sits.",
    "",
    "Every digest a document names should appear in that output. Every `result`",
    "should match the file you get by replaying. Nothing else in this folder is",
    "hashed, this file included.",
    "",
    "`historica check --complete` is that same walk with the tool holding the pen.",
    "Plain `check` hashes every file here and fails where the store contradicts",
    "itself; `--complete` asks the second question — whether every byte a revision",
    "names is present — and fails where it is not. Without the flag a shortfall is",
    "a note and the command still succeeds, because a copy still being delivered is",
    "not a broken one. A backup about to be trusted, or a sync that should have",
    "finished, is asking the second question."
  ], "\n") ++ "\n"

# `cache/README.txt`: that everything beside it may be deleted.
def CACHE_NOTE() -> String:
  String.join([
    "Everything in this directory is derived from other files.",
    "You may delete any or all of it; Historica will rebuild what it needs.",
    "",
    "Each file here is named by the SHA-256 of its own bytes, as everything in this",
    "store is, and holds one of your files as it stood at one revision. That is a",
    "number the operation document for that revision already states, which is how",
    "the file is found again; the bytes are hashed before they are used, so an",
    "entry that has been edited or half-written is ignored rather than believed.",
    "",
    "Nothing points at this directory and nothing depends on it. Deleting it costs",
    "a little time and no information."
  ], "\n") ++ "\n"

# What `historica help` prints, and a usage error after its message: the
# text of the default build, which has `fetch` and decision 0072's dispatch,
# without the newline it ends with.
def USAGE() -> String:
  String.join([
    "usage: historica [-C <dir>] <command> [<arguments>]",
    "",
    "reading a store",
    "  status [--onto <target>] [--merge <target>]",
    "                           how the folder differs from what is recorded",
    "  log [<target>|<from>..<to>] [--limit <count>] [--author <text>]",
    "      [--grep <text>] [--since <when>] [--until <when>] [--path <path>]",
    "      [--fields]",
    "                           the history, newest first; the filters compose and",
    "                           --limit counts what they left. a range covers what",
    "                           <to> has behind it and <from> does not, which is",
    "                           defined for two revisions the graph left concurrent",
    "                           as readily as for two along a chain. --path follows",
    "                           the file rather than the name, so a rename is not a",
    "                           break in it, and a range reads it at <to>. --since",
    "                           and --until are read in each revision's own offset,",
    "                           and a bare `YYYY-MM-DD` is that whole day there.",
    "                           --fields prints the same listing for something that",
    "                           is not a person: a `historica-log-1` header, then",
    "                           one line per revision of",
    "                             <digest> <change> <when> <marks|-> <parent>...",
    "                           spelled whole, single-spaced, nothing escaped",
    "                           because no field can hold a space. what a person",
    "                           wrote is not there — `show` prints the document it",
    "                           lives in, byte for byte",
    "  show <target> [<path>]   one document as stored: a revision, or what it",
    "                           did to one file",
    "  files <target>           the file set at a revision",
    "  cat <target> <path>      one file's content at a revision",
    "  diff [<target>] [<path>] [--onto <target>] [--color <when>]",
    "                           what changed: the folder against the position,",
    "                           or what a revision did. A rendering, not the",
    "                           stored document — `show` is that. A rename",
    "                           between two revisions is stated, because the",
    "                           store recorded it; one in the folder is a drop",
    "                           and an add, because the folder cannot see it.",
    "                           <when> is `auto`, which colours a terminal and",
    "                           nothing else, `always`, or `never`",
    "  blame [<target>] <path> [--lines <first>..<last>]",
    "                           who wrote each line: the change, the author, and",
    "                           the day. Read from the operations rather than",
    "                           guessed at, so a line keeps its author through a",
    "                           rename and through a merge that did not touch it",
    "  names                    the bookmarks, and what they point at",
    "  skip                     the rules saying what history does not take",
    "",
    "writing a store",
    "  record [<path>...] [-m <message>]",
    "                           record what the folder now says; with paths, only",
    "                           what those say, the rest being left unlooked at",
    "         [--onto <target>] [--merge <target>] [--move <old>=<new>]",
    "         [--at <file>=<path>] [--accept <path>] [--bytes <path>]",
    "         [--lines <path>] [--dry-run] [--fields]",
    "                           --bytes and --lines say which kind a file being",
    "                           added is, where the sniff — valid UTF-8 with no",
    "                           NUL is lines — would answer otherwise. Only for a",
    "                           file this records for the first time: a kind is",
    "                           fixed when a file is added, and changing it later",
    "                           is a drop and an add",
    "  amend [<target>]         rewrite the head as the folder now stands",
    "        [-m <message>] [--move <old>=<new>] [--dry-run] [--fields]",
    "                           a revision work stands on takes -m and nothing",
    "                           else: the folder states the head's content and",
    "                           can state no other, so that is a reword, and what",
    "                           stood on it is carried onto the new message",
    "  merge [<target>...]      write what two lines of work say together:",
    "                           what is named, and every head that is not",
    "  update [<target>] [--dry-run]",
    "                           make the folder hold a head: write what it",
    "                           records, remove what it does not, touch nothing",
    "                           unrecorded",
    "  abandon <target> [--only] [-m <why>] [--dry-run] [--fields]",
    "                           supersede this revision, and everything standing",
    "                           on it, with a tombstone that says why. --only",
    "                           abandons the one revision and carries what stood",
    "                           on it onto the tombstone, so the work above",
    "                           survives the work beneath it",
    "  carry [<target>] [--onto <destination>] [--dry-run] [--fields]",
    "                           restate work against a different parent. with no",
    "                           --onto that parent is the rewrite the store",
    "                           already holds, and with no target it repairs",
    "                           every revision `check`'s note names: nothing is",
    "                           stamped or minted, so two replicas repairing one",
    "                           history write the same bytes. --onto is the same",
    "                           restating with a person deciding, so the revision",
    "                           named is stamped and the stack above it derives",
    "                           from that",
    "  prune [--dry-run] [--fields]",
    "                           delete superseded revisions nothing stands on, and",
    "                           content only they name, printing every file",
    "  receive <dir> [--dry-run] [--join-unrelated] [--fields]",
    "                           import immutable history from another local store",
    "  export <dir> [<target>] [--files-only] [--dry-run]",
    "                           write a fresh repository at <dir>: the folder as",
    "                           <target> has it, and the history that leads there.",
    "                           bookmarks and the cache stay here, the shared",
    "                           rules travel and the private ones do not, and",
    "                           nothing unrecorded or skipped can travel, because",
    "                           the copy is assembled rather than mirrored.",
    "                           compressing it is tar's job. --files-only writes",
    "                           the same folder and no history under it, which is",
    "                           for looking at a revision rather than working on",
    "                           one, and wants an empty directory",
    "  offer <dir>              list the transferable files of a published copy, to",
    "                           standard output, for a reader that cannot list the",
    "                           directory it is fetching from: a kind, a digest,",
    "                           what the entry forgets, and the path. writes",
    "                           nothing — redirect it beside the copy, as",
    "                           `offer.txt`, after the `export` that made it",
    "  fetch <url> [--join-unrelated] [--fields]",
    "                           take what a published copy holds and this store",
    "                           lacks: the URL is the manifest `offer` wrote, and",
    "                           every path in it resolves against the directory",
    "                           that manifest sits in. adds history and stops —",
    "                           `update` is the folder's catch-up",
    "  forget <target> <path> [--lines <first>..<last>] [--dry-run] [--fields]",
    "                           destroy those lines everywhere history quotes",
    "                           them, leaving their shape; the file's paths,",
    "                           authors, and times stay recorded. A file of bytes",
    "                           has no lines to name: forget it without a span,",
    "                           and its whole content goes",
    "  identity <author>        say who you are, once, for every repository",
    "  init [<dir>]             make a store in <dir>/history",
    "  check [<dir>] [--complete]",
    "                           read a store and report every fault; --complete",
    "                           also fails when a head's history is not all here",
    "  arrange [-n] [--refile]  rename revision files to readable ones, where they",
    "                           sit: a folder you put a revision in is one you",
    "                           meant. --refile moves them under `YYYY-MM/` too,",
    "                           which is how a store written flat catches up",
    "  name <bookmark> <target> [<path>] [--revision] [--private|--shared]",
    "       [--fields]",
    "                           point a bookmark at a change, pin a revision, or",
    "                           name the file that <path> holds. --private keeps",
    "                           the bookmark's own name out of an `export`; with",
    "                           neither flag, a bookmark keeps the axis it has",
    "  name --delete <bookmark> [--fields]",
    "                           remove a bookmark. the label goes and nothing",
    "                           recorded does — the work is still reached by",
    "                           change ID or digest, and `prune` takes only",
    "                           superseded revisions. local, like every deletion",
    "                           here: a replica that still holds the name brings",
    "                           it back on the next receive",
    "  skip [--private] <path>... [--name <name>]",
    "                           stop history taking a path, a directory, or a",
    "                           name in which `*` is any run of characters.",
    "                           --private keeps the rule's own text out of an",
    "                           `export`; with no arguments, print the rules",
    "",
    "a <target> is `head`, a bookmark, a change ID, or a revision digest; the last",
    "two may",
    "be abbreviated to any unambiguous prefix, and their alphabets do not overlap,",
    "so one argument accepts either. `log` also takes two of them as",
    "`<from>..<to>`; a bookmark whose own name holds `..` is looked up whole first,",
    "so it still names itself.",
    "",
    "a <path> is a path, or `file:` and a file identifier or a file bookmark — an",
    "identifier abbreviates to any prefix unique among the files at that revision.",
    "`path:` says the rest is a path, for a file whose own name begins `file:`.",
    "",
    "--fields on a writing command says where it wrote, for something that is not a",
    "person: a `historica-wrote-1` header, then a line of",
    "  revision <digest> | name <bookmark> | unname <bookmark> | gone <digest>",
    "`revision` and `name` are now in `revisions/` and `names/`, `unname` is a",
    "bookmark removed, and `gone` is a digest nothing is there under. digests are",
    "spelled whole, and a name takes the rest of the line, so a reader splits once.",
    "nothing a document says is restated — the digest is the pointer and the",
    "document is one read away. having written nothing is the header and no lines,",
    "which is what lets a wrapper do nothing at all, and it is what a command that",
    "failed leaves behind too, with the exit code saying so. `--dry-run --fields` is",
    "refused: a plan is not on disk.",
    "",
    "a word that is none of the above is looked for on $PATH as `historica-<word>`,",
    "and run with the arguments as given, in the directory `-C` names. so",
    "`historica git import` is `historica-git import`, and the tool answers for",
    "itself. that is a spelling and not a plugin interface: such a tool is an",
    "ordinary program that works by its own name, and this one neither registers",
    "nor authorises it."
  ], "\n")
